{
  "name": "wf-eq-tree",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s data \"org-build {@}\" --",
    "org-build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/ build/",
    "data": "tsgo -t esnext -m esnext build/data.ts --rewriteRelativeImportExtensions --ignoreConfig && node build/data.js",
    "upload-only": "node build/oss.mjs",
    "upload": "run-s \"build --mode oss\" upload-only "
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@primevue/forms": "^4.5.4",
    "@tailwindcss/vite": "^4.2.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/rxjs": "14.2.1",
    "axios": "^1.13.6",
    "dayjs": "^1.11.19",
    "dexie": "^4.3.0",
    "localforage": "^1.10.0",
    "lodash": "^4.17.23",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.2.1",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.5.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.4.0",
    "@typescript/native-preview": "7.0.0-dev.20260310.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.0",
    "ali-oss": "^6.23.0",
    "eslint": "^10.0.3",
    "eslint-plugin-oxlint": "^1.51.0",
    "eslint-plugin-vue": "^10.8.0",
    "image-size": "^2.0.2",
    "jiti": "^2.6.1",
    "lodash-es": "^4.17.23",
    "lzma": "^2.3.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.53.0",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.9.3",
    "undici": "^7.22.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vue-tsc": "^3.2.5"
  }
}
