{
  "name": "wf-eq-tree",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s data \"org-build {@}\" --",
    "org-build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/ build/",
    "data": "tsgo -t esnext -m esnext build/data.ts --rewriteRelativeImportExtensions --ignoreConfig && node build/data.js",
    "upload-only": "node build/oss.mjs",
    "upload": "run-s \"build --mode oss\" upload-only "
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.2",
    "@primevue/forms": "^4.5.3",
    "@tailwindcss/vite": "^4.1.18",
    "@vueuse/core": "^14.1.0",
    "@vueuse/rxjs": "14.1.0",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "dexie": "^4.2.1",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.3",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.1.18",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.5.3",
    "@tsconfig/node22": "^22.0.5",
    "@types/lodash": "^4.17.21",
    "@types/node": "^25.0.1",
    "@typescript/native-preview": "7.0.0-dev.20251213.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "ali-oss": "^6.23.0",
    "eslint": "^9.39.2",
    "eslint-plugin-oxlint": "^1.32.0",
    "eslint-plugin-vue": "^10.6.2",
    "image-size": "^2.0.2",
    "jiti": "^2.6.1",
    "lodash-es": "^4.17.21",
    "lzma": "^2.3.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.32.0",
    "prettier": "^3.7.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "~5.9.3",
    "undici": "^7.16.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "npm:rolldown-vite@^7.2.11",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.8"
  }
}
