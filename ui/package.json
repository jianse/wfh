{
  "name": "wf-eq-tree",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s data \"org-build {@}\" --",
    "org-build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/ build/",
    "data": "tsgo -t esnext -m esnext build/data.ts --rewriteRelativeImportExtensions && node build/data.js",
    "upload-only": "node build/oss.mjs",
    "upload": "run-s \"build --mode oss\" upload-only "
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.3",
    "@primevue/forms": "^4.3.9",
    "@tailwindcss/vite": "^4.1.13",
    "@vueuse/core": "^13.9.0",
    "@vueuse/rxjs": "14.0.0-alpha.0",
    "axios": "^1.11.0",
    "dayjs": "^1.11.18",
    "dexie": "^4.2.0",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.9",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.1.13",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.3.9",
    "@tsconfig/node22": "^22.0.2",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.1",
    "@typescript/native-preview": "7.0.0-dev.20250908.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "ali-oss": "^6.23.0",
    "eslint": "^9.35.0",
    "eslint-plugin-oxlint": "^1.14.0",
    "eslint-plugin-vue": "^10.4.0",
    "image-size": "^2.0.2",
    "jiti": "^2.5.1",
    "lodash-es": "^4.17.21",
    "lzma": "^2.3.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.14.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "~5.9.2",
    "undici": "^7.15.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "npm:rolldown-vite@^7.1.8",
    "vite-plugin-vue-devtools": "^8.0.1",
    "vue-tsc": "^3.0.6"
  }
}
