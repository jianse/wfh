{
  "name": "wf-eq-tree",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s data \"org-build {@}\" --",
    "org-build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/ build/",
    "data": "tsgo -t esnext -m esnext build/data.ts --rewriteRelativeImportExtensions && node build/data.js",
    "upload-only": "node build/oss.mjs",
    "upload": "run-s \"build --mode oss\" upload-only "
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.2",
    "@primevue/forms": "^4.3.6",
    "@tailwindcss/vite": "^4.1.11",
    "@vueuse/core": "^13.6.0",
    "@vueuse/rxjs": "^13.6.0",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.11",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.6",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.1.11",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.3.6",
    "@tsconfig/node22": "^22.0.2",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.17.0",
    "@typescript/native-preview": "7.0.0-dev.20250705.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "ali-oss": "^6.23.0",
    "eslint": "^9.32.0",
    "eslint-plugin-oxlint": "^0.15.15",
    "eslint-plugin-vue": "^9.33.0",
    "image-size": "^2.0.2",
    "jiti": "^2.5.1",
    "lodash-es": "^4.17.21",
    "lzma": "^2.3.2",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^0.15.15",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "~5.7.3",
    "undici": "^7.13.0",
    "unocss": "^66.3.3",
    "unplugin-vue-components": "^28.8.0",
    "vite": "npm:rolldown-vite@^7.0.12",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vue-tsc": "^2.2.12"
  }
}
